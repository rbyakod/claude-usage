#!/usr/bin/env bash
set -euo pipefail

log_dir="${CLAUDE_XCODE_LOG_DIR:-/tmp/claude-xcode-kit/logs}"
mkdir -p "$log_dir"
timestamp="$(date +%Y%m%d-%H%M%S)"
log_path="$log_dir/xcode-test-$timestamp.log"

set +e
xcodebuild test "$@" >"$log_path" 2>&1
status=$?
set -e

line_count="$(wc -l <"$log_path" | tr -d ' ')"
fail_count="$(grep -Ec "failed|Test Case '.*' failed" "$log_path" || true)"
warning_count="$(grep -c "warning:" "$log_path" || true)"
error_count="$(grep -c "error:" "$log_path" || true)"

if [ "$status" -eq 0 ]; then
  echo "TEST PASSED"
else
  echo "TEST FAILED"
fi

echo "Output lines: $line_count"
echo "Warnings: $warning_count"
echo "Errors: $error_count"
echo "Failure lines: $fail_count"
echo
"$(dirname "$0")/xcode-errors" "$log_path"
exit "$status"
